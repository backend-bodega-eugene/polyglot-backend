# 复制为 .env.production 后修改。密码建议使用：openssl rand -hex 24
MYSQL_ROOT_PASSWORD=replace_with_a_long_random_root_password
MYSQL_PASSWORD=replace_with_a_long_random_app_password

# 至少 32 个字符，建议使用：openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_32_chars

# 当前测试环境保留Swagger；正式环境分别改为production和false。
THS_APP_ENVIRONMENT=testing
THS_SWAGGER_ENABLED=true
